    {
      "label": "Build and Setup Environment",
      "dependsOrder": "sequence",
      "dependsOn": ["Start Database for Debugging", "Build Frontend and Check Port"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Clear Build Caches",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "echo '🧹 Clearing build caches...'; rm -rf apps/web/.next apps/web/out apps/server/dist 2>/dev/null || true; echo '✅ Build caches cleared'"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Clear Caches and Setup Environment",
      "dependsOrder": "sequence",
      "dependsOn": ["Clear Build Caches", "Start Database for Debugging", "Clear All Development Ports"],
      "group": "build",
      "presentation": {
