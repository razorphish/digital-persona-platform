{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kill Port Conflicts",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/kill-port-conflicts.ps1"]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/kill-port-conflicts.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/kill-port-conflicts.sh"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check and Kill Frontend Port",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy", "Bypass", "-Command",
          "$conn = Get-NetTCPConnection -LocalPort 4000 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Write-Host '🔍 Port 4000 is in use. Killing processes...'; $conn | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 1; Write-Host '✅ Port 4000 cleared' } else { Write-Host '✅ Port 4000 is available' }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-c",
          "if lsof -Pi :4000 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '🔍 Port 4000 is in use. Killing processes...'; lsof -ti:4000 | xargs kill -9 2>/dev/null || true; sleep 1; echo '✅ Port 4000 cleared'; else echo '✅ Port 4000 is available'; fi"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-c",
          "if lsof -Pi :4000 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '🔍 Port 4000 is in use. Killing processes...'; lsof -ti:4000 | xargs kill -9 2>/dev/null || true; sleep 1; echo '✅ Port 4000 cleared'; else echo '✅ Port 4000 is available'; fi"
        ]
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Check and Kill Backend Port", 
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy", "Bypass", "-Command",
          "$conn = Get-NetTCPConnection -LocalPort 4001 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Write-Host '🔍 Port 4001 is in use. Killing processes...'; $conn | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Start-Sleep -Seconds 1; Write-Host '✅ Port 4001 cleared' } else { Write-Host '✅ Port 4001 is available' }"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-c",
          "if lsof -Pi :4001 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '🔍 Port 4001 is in use. Killing processes...'; lsof -ti:4001 | xargs kill -9 2>/dev/null || true; sleep 1; echo '✅ Port 4001 cleared'; else echo '✅ Port 4001 is available'; fi"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-c",
          "if lsof -Pi :4001 -sTCP:LISTEN -t >/dev/null 2>&1; then echo '🔍 Port 4001 is in use. Killing processes...'; lsof -ti:4001 | xargs kill -9 2>/dev/null || true; sleep 1; echo '✅ Port 4001 cleared'; else echo '✅ Port 4001 is available'; fi"
        ]
      },
      "group": "build", 
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Clear All Development Ports",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy", "Bypass", "-Command",
          "Write-Host '🧹 Clearing development ports (4000, 4001, 8001)...'; foreach ($port in 4000, 4001, 8001) { $conn = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue; if ($conn) { Write-Host \"🔍 Killing processes on port $port\"; $conn | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } } else { Write-Host \"✅ Port $port is available\" } }; Start-Sleep -Seconds 2; Write-Host '🎉 All ports cleared!'"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "-c",
          "echo '🧹 Clearing development ports (4000, 4001, 8001)...'; for port in 4000 4001 8001; do if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then echo \"🔍 Killing processes on port $port\"; lsof -ti:$port | xargs kill -9 2>/dev/null || true; else echo \"✅ Port $port is available\"; fi; done; sleep 2; echo '🎉 All ports cleared!'"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-c",
          "echo '🧹 Clearing development ports (4000, 4001, 8001)...'; for port in 4000 4001 8001; do if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then echo \"🔍 Killing processes on port $port\"; lsof -ti:$port | xargs kill -9 2>/dev/null || true; else echo \"✅ Port $port is available\"; fi; done; sleep 2; echo '🎉 All ports cleared!'"
        ]
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always", 
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
